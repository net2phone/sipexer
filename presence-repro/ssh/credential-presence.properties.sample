# Copy to credential-presence.properties, fill in, then: chmod 600 credential-presence.properties
# Read by presence-login.sh. Claude runs the script but does not open the real file.
# Format: key=value, one per line, no quotes, no spaces around '='.

# login user on the presence servers
username=tmp_claude_presence

# password of that user (everything after the first '=' is used as is)
password=CHANGE_ME

# space-separated presence hosts: alias=ip
hosts=presence-6071-a=10.131.213.239 presence-6071-b=10.131.214.55

# optional: bastion as user@host[:port], empty = direct
jump=

# optional: how long the shared connection stays open (ssh ControlPersist)
persist=8h
